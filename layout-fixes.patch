--- /private/tmp/claude-501/-Users-l-Desktop-projects-fayzcontrol/e574b6ae-89eb-4b14-80e3-d84da1d95d05/scratchpad/orig_ux/fayzcontrol.uz/css/unified_header.css	2026-09-15 21:49:02
+++ css/unified_header.css	2026-09-16 11:58:15
@@ -1091,5 +1091,287 @@
 [data-theme="day"] .fmh-confirm-btn-cancel:hover, body.day-mode .fmh-confirm-btn-cancel:hover {
   background: #f1f5f9 !important;
   color: #0f172a !important;
+}
+
+
+/* ==========================================================================
+   KEYBOARD FOCUS VISIBILITY
+   --------------------------------------------------------------------------
+   Every portal stylesheet sets `outline: none` on its controls, and the only
+   :focus rules that existed covered text fields and two dialog buttons. That
+   left navigation pills, header buttons and filter pills with no focus
+   indicator at all, so tabbing through a portal gave no sign of position.
+
+   These rules use :focus-visible, which the browser applies for keyboard
+   navigation but NOT for mouse clicks — so the appearance during normal
+   pointer use is unchanged. Colours come from the existing --primary token,
+   so the ring follows the active day/night theme automatically.
+   ========================================================================== */
+
+.portal-nav-pill:focus-visible,
+.portal-brand:focus-visible,
+.btn-header-primary:focus-visible,
+.btn-header-outline:focus-visible,
+.btn-unified-theme-toggle:focus-visible,
+.portal-user-chip:focus-visible,
+.filter-pill:focus-visible,
+.doc-pill-btn:focus-visible,
+.fmh-confirm-btn:focus-visible,
+a:focus-visible,
+button:focus-visible,
+[tabindex]:not([tabindex="-1"]):focus-visible,
+summary:focus-visible {
+  outline: 2px solid var(--primary, #38bdf8) !important;
+  outline-offset: 2px !important;
+  box-shadow: 0 0 0 4px var(--primary-glow, rgba(56, 189, 248, 0.25)) !important;
+  border-radius: inherit;
+}
+
+/* Form fields already carry a focus ring; keep it and add the outline so the
+   indicator is consistent no matter which control the keyboard lands on. */
+input:focus-visible,
+select:focus-visible,
+textarea:focus-visible {
+  outline: 2px solid var(--primary, #38bdf8) !important;
+  outline-offset: 1px !important;
+}
+
+/* The confirm dialog's default button is focused on open; make that obvious. */
+.fmh-confirm-btn:focus-visible {
+  outline-offset: 3px !important;
+}
+
+/* Windows high-contrast / forced-colors mode ignores custom colours, so fall
+   back to a system-defined ring rather than losing the indicator entirely. */
+@media (forced-colors: active) {
+  a:focus-visible,
+  button:focus-visible,
+  input:focus-visible,
+  select:focus-visible,
+  textarea:focus-visible,
+  [tabindex]:not([tabindex="-1"]):focus-visible {
+    outline: 3px solid Highlight !important;
+    outline-offset: 2px !important;
+  }
+}
+
+/* ==========================================================================
+   MINIMUM TARGET SIZE
+   --------------------------------------------------------------------------
+   Below 1080px the navigation pills collapse to icon-only with 4px/6px
+   padding, which measured 22px wide — under the 24x24 CSS-pixel floor in
+   WCAG 2.2 AA (2.5.8 Target Size, Minimum) and awkward to hit on a tablet
+   during ward rounds. Squaring them to 32px keeps the header's height and
+   spacing unchanged while giving a comfortable target.
+   ========================================================================== */
+
+@media (max-width: 1080px) {
+  .portal-master-nav .portal-nav-pill {
+    min-width: 32px !important;
+    min-height: 32px !important;
+    height: 32px !important;
+    justify-content: center !important;
+    padding: 4px !important;
+  }
+  .portal-actions-cluster .btn-header-primary,
+  .portal-actions-cluster .btn-header-outline,
+  .portal-actions-cluster .btn-unified-theme-toggle {
+    min-height: 32px !important;
+  }
+}
+
+/* ==========================================================================
+   HEADER ACTION CLUSTER OVERFLOW
+   --------------------------------------------------------------------------
+   .portal-actions-cluster was pinned to width/min-width/max-width: 290px to
+   mirror the 290px brand anchor and keep the centre nav optically centred.
+   But its four controls (A4 Blanklar, Yangi Qabul, theme toggle, Sayt) need
+   about 407px. With justify-content: flex-end, flex-wrap: nowrap and visible
+   overflow, the surplus ~117px spilled out of the LEFT edge of the box, so the
+   first button rendered on top of the last navigation pill and the two read as
+   one doubled control. The 290px lock is only released below 1080px, so this
+   affected roughly 1081px-1640px — i.e. most desktop widths, 1440 and 1512
+   included.
+
+   The cluster now sizes to its content with 290px kept as a floor, and the
+   grid's trailing column tracks it, so the anchor still reads as 290px
+   whenever the buttons fit inside it. There is room for this: at 1512px the
+   brand (290) + nav (743) + cluster (407) come to 1440 inside a 1506px
+   wrapper, so nothing else has to shrink.
+   ========================================================================== */
+
+@media (min-width: 1081px) {
+  .portal-actions-cluster,
+  .super-topbar-right {
+    width: auto !important;
+    min-width: 290px !important;
+    max-width: none !important;
+  }
+}
+
+/* Trailing column follows the cluster. Split by band so each keeps the brand
+   width its own breakpoint already set (240px below 1450px, 290px above). */
+@media (min-width: 1451px) {
+  .portal-nav-wrapper {
+    grid-template-columns: 290px 1fr minmax(290px, auto) !important;
+  }
+}
+
+@media (min-width: 1081px) and (max-width: 1450px) {
+  .portal-nav-wrapper {
+    grid-template-columns: 240px 1fr minmax(290px, auto) !important;
+  }
+}
+
+/* ==========================================================================
+   HEADER STAT CHIPS
+   --------------------------------------------------------------------------
+   .header-stat-chip had no styling at all — the markup exists on the
+   Qabulxona, CRM, Buxgalteriya and HR pages, but nothing ever gave it padding,
+   a background or a border. The three stats were bare text separated only by
+   an 8px flex gap set inline, so "Real Bo'sh: 14  Bugun: 0  Yangi lid: 0" ran
+   together as one continuous line instead of reading as three figures.
+
+   Each chip now sits in its own pill with real separation between them.
+   Colours come from the existing tokens, so the strip follows the day/night
+   theme like the rest of the header.
+   ========================================================================== */
+
+.portal-center-chips {
+  display: flex !important;
+  align-items: center !important;
+  gap: 0.75rem !important;
+  flex-wrap: wrap !important;
+  row-gap: 0.4rem !important;
 }
 
+.header-stat-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  padding: 5px 11px;
+  border-radius: 999px;
+  background: var(--bg-panel, #0a1b33);
+  border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
+  font-size: 0.78rem;
+  line-height: 1.2;
+  color: var(--text-secondary, #cbd5e1);
+  white-space: nowrap;
+  transition: background 0.15s ease, border-color 0.15s ease;
+}
+
+.header-stat-chip:hover {
+  background: var(--bg-panel-hover, #122c54);
+  border-color: var(--border-color, rgba(255, 255, 255, 0.09));
+}
+
+/* The figure itself should outweigh its label. */
+.header-stat-chip .val {
+  font-weight: 800;
+  font-size: 0.86rem;
+  color: var(--text-primary, #f8fafc);
+  font-variant-numeric: tabular-nums;
+}
+
+.header-stat-chip i {
+  font-size: 0.82rem;
+  flex: 0 0 auto;
+}
+
+/* Day mode needs a lighter ground than --bg-panel, which stays dark there. */
+[data-theme="day"] .header-stat-chip,
+body.day-mode .header-stat-chip {
+  background: #f1f5f9;
+  border-color: #e2e8f0;
+  color: #334155;
+}
+
+[data-theme="day"] .header-stat-chip:hover,
+body.day-mode .header-stat-chip:hover {
+  background: #e2e8f0;
+  border-color: #cbd5e1;
+}
+
+[data-theme="day"] .header-stat-chip .val,
+body.day-mode .header-stat-chip .val {
+  color: #0f172a;
+}
+
+/* ==========================================================================
+   SUPER-PORTAL HEADER CROWDING
+   --------------------------------------------------------------------------
+   superpage.html carries two header widgets no other portal has: the user /
+   role switcher (~182px) and the gold Superadmin button (~121px). With those
+   added, the header needs roughly 1717px of content — brand 290 + full nav 710
+   + cluster 717 — but .portal-nav-wrapper is capped at max-width: 1640px. It
+   therefore could never fit at ANY window size, and the surplus spilled out of
+   the cluster's left edge: the user widget landed on top of "HR & Kadrlar" and
+   "Qabulxona", and the Superadmin button on top of "CRM". Measured overlaps
+   ran from 900px right up to 1920px.
+
+   Fixed in three parts:
+     1. The nav zone may shrink (min-width: 0) and clips rather than overlaps,
+        so a shortfall can never again stack controls on top of each other.
+     2. Non-active nav labels collapse to their icons — the same treatment the
+        design already applies below 1450px — which brings the nav from ~710px
+        down to ~320px and buys back the space the two extra widgets need.
+     3. The two extra widgets then compact in stages as the window narrows.
+   ========================================================================== */
+
+body.super-portal-page .portal-center-nav-zone,
+body.super-portal-page .portal-master-nav {
+  min-width: 0 !important;
+}
+
+body.super-portal-page .portal-master-nav {
+  overflow: hidden !important;
+}
+
+/* 2. Icon-only nav except the current section, which keeps its label. */
+body.super-portal-page .portal-master-nav .portal-nav-pill:not(.active) span {
+  display: none !important;
+}
+
+/* 3a. Drop the name/role text in the switcher, keeping the crown and chevron. */
+@media (max-width: 1500px) {
+  body.super-portal-page .user-role-widget .user-info-cluster {
+    display: none !important;
+  }
+}
+
+/* 3b. Then the Superadmin button's label, keeping its crown icon. */
+@media (max-width: 1380px) {
+  body.super-portal-page .btn-superadmin-gold span {
+    display: none !important;
+  }
+}
+
+/* 3c. Then the secondary action labels, so the primary action stays readable. */
+@media (max-width: 1280px) {
+  body.super-portal-page .portal-actions-cluster a.btn-header-outline span {
+    display: none !important;
+  }
+}
+
+/* ==========================================================================
+   NARROW-WIDTH CLUSTER CAP
+   --------------------------------------------------------------------------
+   The max-width: 1080px block releases the cluster's width and min-width back
+   to auto but leaves the base rule's `max-width: 290px` in force, so the box
+   stayed capped at 290px while its contents needed more and spilled out of the
+   left edge again. Releasing the cap completes that override.
+
+   The Super-Portal's theme toggle also keeps its full label at this size,
+   where every other action has already collapsed to an icon; collapsing it too
+   keeps the row inside the viewport.
+   ========================================================================== */
+
+@media (max-width: 1080px) {
+  .portal-actions-cluster,
+  .super-topbar-right {
+    max-width: none !important;
+  }
+  body.super-portal-page .btn-unified-theme-toggle span {
+    display: none !important;
+  }
+}
