# --- Local database credentials. -------------------------------------------
# db_config.json holds a database password in plaintext, so it must never be
# committed. Copy db_config.example.json to db_config.json on each machine and
# fill in that machine's own values.
db_config.json

# --- Broken vendored copy of pymysql -------------------------------------
# The zip export shipped pymysql/ with an empty constants/ package, so it
# shadowed the real installed module and broke every import. Kept aside
# while debugging; install PyMySQL from pip instead (see README).
pymysql.broken.vendored/

# --- Generated PDFs / exports ---
*.pdf
!assets/**/*.pdf
# Backups of the credential file are credential files too.
db_config.json.*
db_config.*.bak
