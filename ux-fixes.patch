+
+
+/* ==========================================================================
+   KEYBOARD FOCUS VISIBILITY
+   --------------------------------------------------------------------------
+   Every portal stylesheet sets `outline: none` on its controls, and the only
+   :focus rules that existed covered text fields and two dialog buttons. That
+   left navigation pills, header buttons and filter pills with no focus
+   indicator at all, so tabbing through a portal gave no sign of position.
+
+   These rules use :focus-visible, which the browser applies for keyboard
+   navigation but NOT for mouse clicks — so the appearance during normal
+   pointer use is unchanged. Colours come from the existing --primary token,
+   so the ring follows the active day/night theme automatically.
+   ========================================================================== */
+
+.portal-nav-pill:focus-visible,
+.portal-brand:focus-visible,
+.btn-header-primary:focus-visible,
+.btn-header-outline:focus-visible,
+.btn-unified-theme-toggle:focus-visible,
+.portal-user-chip:focus-visible,
+.filter-pill:focus-visible,
+.doc-pill-btn:focus-visible,
+.fmh-confirm-btn:focus-visible,
+a:focus-visible,
+button:focus-visible,
+[tabindex]:not([tabindex="-1"]):focus-visible,
+summary:focus-visible {
+  outline: 2px solid var(--primary, #38bdf8) !important;
+  outline-offset: 2px !important;
+  box-shadow: 0 0 0 4px var(--primary-glow, rgba(56, 189, 248, 0.25)) !important;
+  border-radius: inherit;
+}
+
+/* Form fields already carry a focus ring; keep it and add the outline so the
+   indicator is consistent no matter which control the keyboard lands on. */
+input:focus-visible,
+select:focus-visible,
+textarea:focus-visible {
+  outline: 2px solid var(--primary, #38bdf8) !important;
+  outline-offset: 1px !important;
+}
+
+/* The confirm dialog's default button is focused on open; make that obvious. */
+.fmh-confirm-btn:focus-visible {
+  outline-offset: 3px !important;
 }
 
+/* Windows high-contrast / forced-colors mode ignores custom colours, so fall
+   back to a system-defined ring rather than losing the indicator entirely. */
+@media (forced-colors: active) {
+  a:focus-visible,
+  button:focus-visible,
+  input:focus-visible,
+  select:focus-visible,
+  textarea:focus-visible,
+  [tabindex]:not([tabindex="-1"]):focus-visible {
+    outline: 3px solid Highlight !important;
+    outline-offset: 2px !important;
+  }
+}
+
+/* ==========================================================================
+   MINIMUM TARGET SIZE
+   --------------------------------------------------------------------------
+   Below 1080px the navigation pills collapse to icon-only with 4px/6px
+   padding, which measured 22px wide — under the 24x24 CSS-pixel floor in
+   WCAG 2.2 AA (2.5.8 Target Size, Minimum) and awkward to hit on a tablet
+   during ward rounds. Squaring them to 32px keeps the header's height and
+   spacing unchanged while giving a comfortable target.
+   ========================================================================== */
+
+@media (max-width: 1080px) {
+  .portal-master-nav .portal-nav-pill {
+    min-width: 32px !important;
+    min-height: 32px !important;
+    height: 32px !important;
+    justify-content: center !important;
+    padding: 4px !important;
+  }
+  .portal-actions-cluster .btn-header-primary,
+  .portal-actions-cluster .btn-header-outline,
+  .portal-actions-cluster .btn-unified-theme-toggle {
+    min-height: 32px !important;
+  }
+}
