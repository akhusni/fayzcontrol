# Fayz Control (fayzcontrol.uz) — Apache hardening
#
# READ THIS BEFORE CHANGING IT.
#
# This application is NOT designed to be served by Apache. Every portal page
# is gated server-side by server.py: it checks the session cookie and sends an
# anonymous visitor to login.html. If Apache serves the .html files straight
# off disk, that check never runs and the entire EMR — doctor, reception,
# accounting, HR, patient records — is handed to anyone who knows a filename.
#
# This file used to do exactly that. It set `DirectoryIndex superpage.html`
# and routed /api/* to api.php, which has been removed; see
# DEPLOYMENT_AND_DOMAINS.md for the reverse-proxy setup that replaces it.
#
# What is left here is damage limitation, for the case where this directory
# ends up inside an Apache docroot anyway: it stops the source, the database
# credentials and the clinical data files from being downloadable.

# --- Never serve source, credentials, data or documentation ----------------
<FilesMatch "\.(py|pyc|sql|json|md|txt|log|bat|ps1|example)$">
  Require all denied
</FilesMatch>

# db_config.json holds the database password in plaintext. It is gitignored,
# but it is present on a deployed machine, and it sits in this directory.
<FilesMatch "^(db_config.*|server_log.*|\.htaccess|\.gitignore|\.vercelignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_alias.c>
  RedirectMatch 403 ^/(data|tests|assets/private)/
</IfModule>

# robots.txt is meant to be readable; the rule above denies .txt, so allow it
# back explicitly.
<Files "robots.txt">
  Require all granted
</Files>

# --- Keep clinical pages out of search engines -----------------------------
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  # No Access-Control-Allow-Origin here. It used to be "*", on every response,
  # which invited any site on the internet to call this API. The portals are
  # served from the same origin and need no CORS at all.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>
